+class TestDispatchEventInviteRedemption:
+    """Exercises the _dispatch_event integration, not just LineInviteStore
+    in isolation: a matched invite must grant access via
+    PairingStore._approve_user and short-circuit before the generic
+    pairing-code reply; a non-match must fall through unchanged."""
+
+    def _make_adapter(self, monkeypatch, **extra):
+        monkeypatch.setenv("LINE_CHANNEL_ACCESS_TOKEN", "t")
+        monkeypatch.setenv("LINE_CHANNEL_SECRET", "s")
+        from gateway.config import PlatformConfig
+        adapter = LineAdapter(PlatformConfig(enabled=True, extra=extra))
+        adapter._handle_message_event = AsyncMock()
+        adapter.send = AsyncMock(return_value=_line.SendResult(success=True))
+        return adapter
+
+    def test_valid_invite_grants_access_and_does_not_reach_pairing_handler(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        adapter = self._make_adapter(monkeypatch)
+        token = adapter._invites.mint("Jamie", "Umanager")
+
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ucandidate"},
+            "message": {"type": "text", "text": token},
+            "replyToken": "rt-1",
+        }
+        asyncio.run(adapter._dispatch_event(event))
+
+        # Did NOT fall through to the generic pairing-code path.
+        adapter._handle_message_event.assert_not_awaited()
+        # Welcome message sent to the candidate.
+        adapter.send.assert_any_await("Ucandidate", adapter.invite_welcome_text)
+
+        from gateway.pairing import PairingStore
+        assert PairingStore().is_approved("line", "Ucandidate") is True
+
+    def test_valid_invite_notifies_the_creator(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        adapter = self._make_adapter(monkeypatch)
+        token = adapter._invites.mint("Jamie", "Umanager")
+
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ucandidate"},
+            "message": {"type": "text", "text": token},
+            "replyToken": "rt-1",
+        }
+        asyncio.run(adapter._dispatch_event(event))
+
+        notify_calls = [c for c in adapter.send.await_args_list if c.args[0] == "Umanager"]
+        assert len(notify_calls) == 1
+        assert "Jamie" in notify_calls[0].args[1]
+
+    def test_approved_name_falls_back_to_invite_label_not_raw_user_id(self, monkeypatch, tmp_path):
+        # Regression guard: this adapter's own get_profile() lookup can fail
+        # (unconnected client, LINE API hiccup, etc.) — when it does, the
+        # approved-user record must fall back to the name the manager
+        # supplied when minting the invite, not silently repeat the LINE
+        # user ID as both the ID and the "name". The bug this guards
+        # against shipped two real Approved-users entries where the name
+        # column was just the ID again.
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        adapter = self._make_adapter(monkeypatch)
+        adapter._client = None  # no LINE profile lookup available
+        token = adapter._invites.mint("Jamie", "Umanager")
+
+        from gateway.pairing import PairingStore
+        captured = {}
+        original_approve_user = PairingStore._approve_user
+
+        def spy_approve_user(self, platform, uid, name):
+            captured["name"] = name
+            return original_approve_user(self, platform, uid, name)
+
+        monkeypatch.setattr(PairingStore, "_approve_user", spy_approve_user)
+
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ucandidate"},
+            "message": {"type": "text", "text": token},
+            "replyToken": "rt-1",
+        }
+        asyncio.run(adapter._dispatch_event(event))
+
+        assert captured["name"] == "Jamie"
+
+    def test_invalid_token_falls_through_to_pairing_handler_unchanged(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        adapter = self._make_adapter(monkeypatch)
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ustranger"},
+            "message": {"type": "text", "text": "just saying hi"},
+            "replyToken": "rt-1",
+        }
+        asyncio.run(adapter._dispatch_event(event))
+
+        # Falls through unchanged: default dm_policy is "pairing", so this
+        # still reaches the generic handler exactly as it did pre-6c.
+        adapter._handle_message_event.assert_awaited_once()
+
+    def test_token_cannot_be_redeemed_twice_by_a_third_party(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        adapter = self._make_adapter(monkeypatch)
+        token = adapter._invites.mint("Jamie", "Umanager")
+
+        first = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ucandidate"},
+            "message": {"type": "text", "text": token},
+            "replyToken": "rt-1",
+        }
+        asyncio.run(adapter._dispatch_event(first))
+        adapter._handle_message_event.reset_mock()
+
+        second = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Uinterloper"},
+            "message": {"type": "text", "text": token},
+            "replyToken": "rt-2",
+        }
+        asyncio.run(adapter._dispatch_event(second))
+
+        # The reused token must fall through to the generic pairing path,
+        # not grant a second, unrelated user access.
+        adapter._handle_message_event.assert_awaited_once()
+        from gateway.pairing import PairingStore
+        assert PairingStore().is_approved("line", "Uinterloper") is False
+
+    def test_disabled_dm_policy_still_allows_invite_redemption(self, monkeypatch, tmp_path):
+        # The invite grant is independent of dm_policy — a manager-vetted
+        # candidate must get in even on a locked-down channel.
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        adapter = self._make_adapter(monkeypatch, dm_policy="disabled")
+        token = adapter._invites.mint("Jamie", "Umanager")
+
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ucandidate"},
+            "message": {"type": "text", "text": token},
+            "replyToken": "rt-1",
+        }
+        asyncio.run(adapter._dispatch_event(event))
+
+        from gateway.pairing import PairingStore
+        assert PairingStore().is_approved("line", "Ucandidate") is True
