+# ---------------------------------------------------------------------------
+# 10. DM pairing (dm_policy)
+# ---------------------------------------------------------------------------
+
+class TestDmPolicy:
+    """LINE previously ran its own three-list allowlist check in
+    _dispatch_event and dropped unauthorized DMs before they ever reached
+    the gateway's central pairing logic. dm_policy (mirroring
+    WeCom/Weixin/QQBot/WhatsApp) fixes that: unrecognized DMs now fall
+    through to the gateway when pairing-eligible, while groups/rooms keep
+    the original strict allowlist-only behavior."""
+
+    def _make_adapter(self, monkeypatch, **extra):
+        monkeypatch.setenv("LINE_CHANNEL_ACCESS_TOKEN", "t")
+        monkeypatch.setenv("LINE_CHANNEL_SECRET", "s")
+        from gateway.config import PlatformConfig
+        return LineAdapter(PlatformConfig(enabled=True, extra=extra))
+
+    def test_dm_policy_defaults_to_pairing(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        assert adapter._dm_policy == "pairing"
+
+    def test_dm_policy_explicit_extra(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch, dm_policy="allowlist")
+        assert adapter._dm_policy == "allowlist"
+
+    def test_dm_policy_from_env(self, monkeypatch):
+        monkeypatch.setenv("LINE_DM_POLICY", "disabled")
+        adapter = self._make_adapter(monkeypatch)
+        assert adapter._dm_policy == "disabled"
+
+    def test_extra_takes_precedence_over_env(self, monkeypatch):
+        monkeypatch.setenv("LINE_DM_POLICY", "disabled")
+        adapter = self._make_adapter(monkeypatch, dm_policy="open")
+        assert adapter._dm_policy == "open"
+
+    def test_enforces_own_access_policy_is_true(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        assert adapter.enforces_own_access_policy is True
+
+    def test_intake_disabled_blocks_everyone(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch, dm_policy="disabled")
+        assert adapter._is_dm_intake_allowed("Uany") is False
+
+    def test_intake_allowlist_matches_allowed_users_only(self, monkeypatch):
+        monkeypatch.setenv("LINE_ALLOWED_USERS", "Uok")
+        adapter = self._make_adapter(monkeypatch, dm_policy="allowlist")
+        assert adapter._is_dm_intake_allowed("Uok") is True
+        assert adapter._is_dm_intake_allowed("Uother") is False
+
+    def test_intake_pairing_lets_anyone_through_to_gateway(self, monkeypatch):
+        # This is the whole point: pairing does NOT mean "authorized" — it
+        # means "eligible to reach the gateway's own pairing-code flow".
+        adapter = self._make_adapter(monkeypatch, dm_policy="pairing")
+        assert adapter._is_dm_intake_allowed("Uany") is True
+
+    def test_intake_open_follows_allow_all(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch, dm_policy="open")
+        assert adapter._is_dm_intake_allowed("Uany") is False
+        monkeypatch.setenv("LINE_ALLOW_ALL_USERS", "true")
+        adapter = self._make_adapter(monkeypatch, dm_policy="open")
+        assert adapter._is_dm_intake_allowed("Uany") is True
+
