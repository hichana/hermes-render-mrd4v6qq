+class TestDispatchEventDmPairing:
+    """Exercises the actual _dispatch_event gate rewrite, not just the
+    _is_dm_intake_allowed helper in isolation."""
+
+    def _make_adapter(self, monkeypatch, **extra):
+        monkeypatch.setenv("LINE_CHANNEL_ACCESS_TOKEN", "t")
+        monkeypatch.setenv("LINE_CHANNEL_SECRET", "s")
+        from gateway.config import PlatformConfig
+        adapter = LineAdapter(PlatformConfig(enabled=True, extra=extra))
+        adapter._handle_message_event = AsyncMock()
+        adapter._handle_postback_event = AsyncMock()
+        return adapter
+
+    def test_unrecognized_dm_default_policy_reaches_handler(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ustranger"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        asyncio.run(adapter._dispatch_event(event))
+        adapter._handle_message_event.assert_awaited_once()
+
+    def test_unrecognized_dm_disabled_policy_still_dropped(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch, dm_policy="disabled")
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ustranger"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        asyncio.run(adapter._dispatch_event(event))
+        adapter._handle_message_event.assert_not_awaited()
+
+    def test_unrecognized_dm_allowlist_policy_still_dropped(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch, dm_policy="allowlist")
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ustranger"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        asyncio.run(adapter._dispatch_event(event))
+        adapter._handle_message_event.assert_not_awaited()
+
+    def test_unrecognized_group_message_still_dropped_regardless_of_dm_policy(self, monkeypatch):
+        # Pairing is DM-only — a pairing-friendly dm_policy must not leak
+        # into group/room gating.
+        adapter = self._make_adapter(monkeypatch, dm_policy="pairing")
+        event = {
+            "type": "message",
+            "source": {"type": "group", "groupId": "Cstranger", "userId": "Uany"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        asyncio.run(adapter._dispatch_event(event))
+        adapter._handle_message_event.assert_not_awaited()
+
+    def test_unrecognized_room_message_still_dropped_regardless_of_dm_policy(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch, dm_policy="pairing")
+        event = {
+            "type": "message",
+            "source": {"type": "room", "roomId": "Rstranger", "userId": "Uany"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        asyncio.run(adapter._dispatch_event(event))
+        adapter._handle_message_event.assert_not_awaited()
+
+    def test_already_allowlisted_user_still_reaches_handler(self, monkeypatch):
+        # Regression check on the pre-existing three-list behavior: an
+        # explicitly allowlisted user must keep working unchanged, even
+        # under a strict dm_policy.
+        monkeypatch.setenv("LINE_ALLOWED_USERS", "Uok")
+        adapter = self._make_adapter(monkeypatch, dm_policy="disabled")
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Uok"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        asyncio.run(adapter._dispatch_event(event))
+        adapter._handle_message_event.assert_awaited_once()
+
+    def test_already_allowlisted_group_still_reaches_handler(self, monkeypatch):
+        monkeypatch.setenv("LINE_ALLOWED_GROUPS", "Cok")
+        adapter = self._make_adapter(monkeypatch)
+        event = {
+            "type": "message",
+            "source": {"type": "group", "groupId": "Cok", "userId": "Uany"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        asyncio.run(adapter._dispatch_event(event))
+        adapter._handle_message_event.assert_awaited_once()
