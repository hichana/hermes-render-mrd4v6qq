+# 11. One-off join invites (Phase 6c: manager-initiated QR invite)
+# ---------------------------------------------------------------------------
+
+class TestLineInviteStore:
+    """Invite store: mint/expire/single-use-redeem/already-redeemed/
+    not-found, plus the per-uid guessing-protection lockout — mirroring the
+    style of gateway.pairing's PairingStore tests, since a matched invite
+    grants access immediately with no approval step and needs the same
+    guessing protection pairing codes get."""
+
+    def test_mint_returns_token_of_configured_length(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        store = LineInviteStore()
+        token = store.mint("Jamie — PT cashier", "Umanager")
+        assert len(token) == _line.LINE_INVITE_TOKEN_LENGTH
+        assert set(token) <= set(_line.LINE_INVITE_ALPHABET)
+
+    def test_redeem_valid_token_returns_entry_and_marks_redeemed(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        store = LineInviteStore()
+        token = store.mint("Jamie", "Umanager")
+
+        entry = store.try_redeem("Ucandidate", token)
+        assert entry is not None
+        assert entry["label"] == "Jamie"
+        assert entry["created_by"] == "Umanager"
+
+        # Single-use: the same token must not redeem twice, even from a
+        # different uid.
+        assert store.try_redeem("Uother", token) is None
+
+    def test_redeem_unknown_token_fails_safe(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        store = LineInviteStore()
+        store.mint("Jamie", "Umanager")
+        bogus = "A" * _line.LINE_INVITE_TOKEN_LENGTH
+        assert store.try_redeem("Ucandidate", bogus) is None
+
+    def test_redeem_expired_token_fails(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        store = LineInviteStore()
+        token = store.mint("Jamie", "Umanager", ttl_hours=-1)  # already expired
+        assert store.try_redeem("Ucandidate", token) is None
+
+    def test_ordinary_chat_text_is_not_treated_as_a_token_attempt(self, monkeypatch, tmp_path):
+        # Regression guard: text that isn't token-shaped (wrong length/
+        # alphabet) must short-circuit before touching the store at all, so
+        # normal DM chatter from strangers (Phase 1/6's manual-onboarding
+        # path) never trips the per-uid lockout below.
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        store = LineInviteStore()
+        assert store.try_redeem("Ustranger", "hi there!") is None
+        assert store._is_locked_out("Ustranger") is False
+
+    def test_repeated_failed_token_shaped_attempts_lock_out_that_uid_only(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        store = LineInviteStore()
+        bogus = "B" * _line.LINE_INVITE_TOKEN_LENGTH
+        for _ in range(_line.LINE_INVITE_MAX_FAILED_ATTEMPTS):
+            assert store.try_redeem("Uguesser", bogus) is None
+        assert store._is_locked_out("Uguesser") is True
+
+        # A different uid, and a real live invite, are unaffected.
+        token = store.mint("Jamie", "Umanager")
+        assert store._is_locked_out("Ucandidate") is False
+        assert store.try_redeem("Ucandidate", token) is not None
+
