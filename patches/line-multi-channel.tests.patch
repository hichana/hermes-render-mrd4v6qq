+    def test_message_event_stamps_source_profile_from_the_current_channel(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        # Use the real _handle_message_event this time (not mocked) so the
+        # build_source()+profile-stamp interaction is actually exercised.
+        adapter._handle_message_event = LineAdapter._handle_message_event.__get__(adapter)
