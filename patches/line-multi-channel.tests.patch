+class TestPairingStoreSharing:
+    """Regression coverage for a second real bug found live on
+    2026-08-02, right after fixing TestProfileAdapterRegistration above:
+    approving a pairing code exactly as instructed did not authorize the
+    next message. Root cause: gateway/pairing.py's module-level
+    PAIRING_DIR is resolved once, at import time, from the default
+    profile's HERMES_HOME — `hermes pairing approve` has no --profile
+    flag and structurally can't target a per-profile store, so an
+    approval always lands in the one global PairingStore. But
+    _register_in_profile_adapters (previous fix) has the side effect of
+    making a channel's profile show up in runner._profile_adapters,
+    which gateway/run.py's own bookkeeping uses to decide which profiles
+    get an ISOLATED PairingStore in runner.pairing_stores — correct for
+    a genuinely separate-credentialed secondary profile, wrong for LINE
+    channels here, which share one global store by design (research/08:
+    LINE IDs are already channel-scoped, no collision risk)."""
+
+    def _make_adapter(self, monkeypatch, **extra):
+        monkeypatch.setenv("LINE_CHANNEL_ACCESS_TOKEN", "default-token")
+        monkeypatch.setenv("LINE_CHANNEL_SECRET", "default-secret")
+        from gateway.config import PlatformConfig
+        return LineAdapter(
+            PlatformConfig(
+                enabled=True,
+                extra={
+                    "channels": [
+                        {
+                            "profile": "coder",
+                            "channel_secret": "s",
+                            "channel_access_token": "t",
+                        }
+                    ],
+                    **extra,
+                },
+            )
+        )
+
+    def test_share_points_the_new_channel_at_the_global_store(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
