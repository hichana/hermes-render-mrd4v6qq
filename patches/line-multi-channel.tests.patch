+class TestAdapterChannelRegistryConstruction:
+    """The adapter's __init__ builds a line_multiplex.ChannelRegistry from
+    its own top-level env/extra fields plus platforms.line.extra.channels.
+    Every currently-live single-channel deployment configures no `channels`
+    at all — that path must produce a registry of exactly one channel and
+    remain byte-identical to the pre-multiplex adapter."""
+
+    def _make_adapter(self, monkeypatch, **extra):
+        monkeypatch.setenv("LINE_CHANNEL_ACCESS_TOKEN", "default-token")
+        monkeypatch.setenv("LINE_CHANNEL_SECRET", "default-secret")
+        from gateway.config import PlatformConfig
+        return LineAdapter(PlatformConfig(enabled=True, extra=extra))
+
+    def test_no_channels_extra_produces_a_single_default_channel(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        assert len(adapter._channels) == 1
+        default = adapter._channels.default()
+        assert default.profile == "default"
+        assert default.channel_secret == "default-secret"
+        assert default.channel_access_token == "default-token"
+        assert default.webhook_path == "/line/webhook"
+
+    def test_additional_channel_is_registered_with_its_own_path(self, monkeypatch):
+        adapter = self._make_adapter(
+            monkeypatch,
+            channels=[
+                {
+                    "profile": "coder",
+                    "channel_secret": "coder-secret",
+                    "channel_access_token": "coder-token",
+                }
+            ],
+        )
+        assert len(adapter._channels) == 2
+        coder = adapter._channels.by_profile("coder")
+        assert coder is not None
+        assert coder.channel_secret == "coder-secret"
+        assert coder.webhook_path == "/line/p/coder/webhook"
+        # Default channel's route is unchanged — the whole point of the
+        # design (zero config change for every already-live instance's
+        # LINE console callback URL).
+        assert adapter._channels.default().webhook_path == "/line/webhook"
+
+    def test_allowlists_and_dm_policy_are_isolated_per_channel(self, monkeypatch):
+        monkeypatch.setenv("LINE_ALLOWED_USERS", "Udefault")
+        adapter = self._make_adapter(
+            monkeypatch,
+            dm_policy="pairing",
+            channels=[
+                {
+                    "profile": "coder",
+                    "channel_secret": "s",
+                    "channel_access_token": "t",
+                    "allowed_users": ["Ucoder"],
+                    "dm_policy": "allowlist",
+                }
+            ],
+        )
+        assert adapter._channels.default().allowed_users == {"Udefault"}
+        assert adapter._channels.default().dm_policy == "pairing"
+        coder = adapter._channels.by_profile("coder")
+        assert coder.allowed_users == {"Ucoder"}
+        assert coder.dm_policy == "allowlist"
