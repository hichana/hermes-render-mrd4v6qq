+class TestHandleWebhookMultiChannel:
+    """_handle_webhook resolves the concrete channel by matching
+    request.path against the registry, verifies the signature against
+    THAT channel's secret, and scopes the whole event batch's dispatch to
+    it via the line_multiplex contextvar. This is the property that
+    matters most: a payload signed with one channel's secret must never
+    be accepted on a different channel's route."""
+
+    def _make_adapter(self, monkeypatch):
+        monkeypatch.setenv("LINE_CHANNEL_ACCESS_TOKEN", "default-token")
+        monkeypatch.setenv("LINE_CHANNEL_SECRET", "default-secret")
+        from gateway.config import PlatformConfig
+        adapter = LineAdapter(
+            PlatformConfig(
+                enabled=True,
+                extra={
+                    "channels": [
+                        {
+                            "profile": "coder",
+                            "channel_secret": "coder-secret",
+                            "channel_access_token": "coder-token",
+                        }
+                    ]
+                },
+            )
+        )
+        adapter._dispatch_event = AsyncMock()
+        return adapter
+
+    @staticmethod
+    def _sign(body: bytes, secret: str) -> str:
+        digest = hmac.new(secret.encode(), body, hashlib.sha256).digest()
+        return base64.b64encode(digest).decode()
+
+    @staticmethod
+    async def _mocked_request(path: str, body: bytes, signature: str):
+        # get_running_loop() (not get_event_loop()) so this only ever runs
+        # inside an already-running loop — needed because each test may
+        # call this helper more than once across separate asyncio.run()
+        # calls, and get_event_loop() raises once no loop is "current"
+        # after a prior asyncio.run() has closed its own.
+        from aiohttp import streams
+        from aiohttp.base_protocol import BaseProtocol
+        from aiohttp.test_utils import make_mocked_request
+
+        loop = asyncio.get_running_loop()
+        payload = streams.StreamReader(BaseProtocol(loop=loop), 2**16, loop=loop)
+        payload.feed_data(body)
+        payload.feed_eof()
+        return make_mocked_request(
+            "POST", path, headers={"X-Line-Signature": signature}, payload=payload
+        )
+
+    async def _post(self, adapter, path: str, body: bytes, signature: str):
+        req = await self._mocked_request(path, body, signature)
+        return await adapter._handle_webhook(req)
+
+    def test_default_channel_route_accepts_its_own_signature(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        body = b'{"events": []}'
+        resp = asyncio.run(self._post(adapter, "/line/webhook", body, self._sign(body, "default-secret")))
+        assert resp.status == 200
+
+    def test_additional_channel_route_accepts_its_own_signature(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        body = b'{"events": []}'
+        resp = asyncio.run(
+            self._post(adapter, "/line/p/coder/webhook", body, self._sign(body, "coder-secret"))
+        )
+        assert resp.status == 200
+
+    def test_cross_channel_signature_is_rejected_coder_secret_on_default_route(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        body = b'{"events": []}'
+        # Signed with coder's secret, POSTed to the DEFAULT channel's route.
+        resp = asyncio.run(self._post(adapter, "/line/webhook", body, self._sign(body, "coder-secret")))
+        assert resp.status == 401
+        adapter._dispatch_event.assert_not_awaited()
+
+    def test_cross_channel_signature_is_rejected_default_secret_on_coder_route(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        body = b'{"events": []}'
+        # Signed with the DEFAULT channel's secret, POSTed to coder's route.
+        resp = asyncio.run(
+            self._post(adapter, "/line/p/coder/webhook", body, self._sign(body, "default-secret"))
+        )
+        assert resp.status == 401
+        adapter._dispatch_event.assert_not_awaited()
+
+    def test_unknown_path_is_not_found_not_misrouted(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        body = b'{"events": []}'
+        resp = asyncio.run(
+            self._post(adapter, "/line/p/nonexistent/webhook", body, self._sign(body, "default-secret"))
+        )
+        assert resp.status == 404
+
+    def test_single_channel_deployment_backward_compat(self, monkeypatch):
+        # No `channels` extra at all — the overwhelming majority shape
+        # today. The unprefixed /line/webhook route must behave exactly
+        # as it did before this patch.
+        monkeypatch.setenv("LINE_CHANNEL_ACCESS_TOKEN", "only-token")
+        monkeypatch.setenv("LINE_CHANNEL_SECRET", "only-secret")
+        from gateway.config import PlatformConfig
+        adapter = LineAdapter(PlatformConfig(enabled=True, extra={}))
+        adapter._dispatch_event = AsyncMock()
+
+        body = b'{"events": []}'
+
+        async def run_both():
+            good = await self._post(adapter, "/line/webhook", body, self._sign(body, "only-secret"))
+            bad = await self._post(adapter, "/line/webhook", body, self._sign(body, "wrong"))
+            return good, bad
+
+        good, bad = asyncio.run(run_both())
+        assert good.status == 200
+        assert bad.status == 401
+
