+    def test_self_echo_filter_is_scoped_to_the_current_channel(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        default = adapter._channels.default()
+        coder = adapter._channels.by_profile("coder")
+        default.bot_user_id = "Ubot-default"
+        coder.bot_user_id = "Ubot-coder"
+
+        # The default channel's own bot id is filtered out under its own
+        # context...
+        event_from_default_bot = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ubot-default"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        token = line_multiplex.set_current(default)
+        try:
+            asyncio.run(adapter._dispatch_event(event_from_default_bot))
+        finally:
+            line_multiplex.reset_current(token)
+        adapter._handle_message_event.assert_not_awaited()
+
+        # ...but does NOT filter coder's bot id, and coder's own bot id
+        # sent under coder's context IS filtered — no cross-channel bleed
+        # in either direction.
+        event_from_coder_bot_under_default_context = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ubot-coder"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        token = line_multiplex.set_current(default)
+        try:
+            asyncio.run(adapter._dispatch_event(event_from_coder_bot_under_default_context))
+        finally:
+            line_multiplex.reset_current(token)
