+        adapter._handle_message_event = LineAdapter._handle_message_event.__get__(adapter)
+        adapter.handle_message = AsyncMock()
+        default = adapter._channels.default()
+
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Uapproved"},
+            "message": {"type": "text", "text": "hi"},
+            "replyToken": "rt-1",
+        }
