+class TestDispatchEventMultiChannel:
+    """Exercises _dispatch_event's channel-aware additions: remembering
+    chat_id -> channel for outbound sends, per-channel self-echo
+    filtering, and the source.profile stamp in _handle_message_event —
+    without any of this affecting single-channel behavior, which the
+    existing TestDispatchEventDmPairing/TestDispatchEventInviteRedemption
+    classes above already cover running with no channel context at all."""
+
+    def _make_adapter(self, monkeypatch, **extra):
+        monkeypatch.setenv("LINE_CHANNEL_ACCESS_TOKEN", "default-token")
+        monkeypatch.setenv("LINE_CHANNEL_SECRET", "default-secret")
+        from gateway.config import PlatformConfig
+        adapter = LineAdapter(
+            PlatformConfig(
+                enabled=True,
+                extra={
+                    "channels": [
+                        {
+                            "profile": "coder",
+                            "channel_secret": "coder-secret",
+                            "channel_access_token": "coder-token",
+                        }
+                    ],
+                    **extra,
+                },
+            )
+        )
+        adapter._handle_message_event = AsyncMock()
+        adapter._handle_postback_event = AsyncMock()
+        return adapter
+
+    def test_dispatch_within_a_channel_context_remembers_the_chat(self, monkeypatch):
+        adapter = self._make_adapter(monkeypatch)
+        coder = adapter._channels.by_profile("coder")
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ucandidate"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        token = line_multiplex.set_current(coder)
+        try:
+            asyncio.run(adapter._dispatch_event(event))
+        finally:
+            line_multiplex.reset_current(token)
+        assert adapter._channels.channel_for_chat("Ucandidate") is coder
+
+    def test_dispatch_with_no_channel_context_does_not_crash_or_remember(self, monkeypatch):
+        # Backward-compat path: existing tests above call _dispatch_event
+        # directly with no _handle_webhook-set context at all.
+        adapter = self._make_adapter(monkeypatch)
+        event = {
+            "type": "message",
+            "source": {"type": "user", "userId": "Ucandidate"},
+            "message": {"type": "text", "text": "hi"},
+        }
+        asyncio.run(adapter._dispatch_event(event))
+        assert adapter._channels.channel_for_chat("Ucandidate") is None
