+class TestSendPathChannelResolution:
+    """send()/_send_text_chunks() must resolve their channel via
+    self._channels.channel_for_chat(chat_id) — NOT the request-scoped
+    _client property — because BasePlatformAdapter.handle_message() spawns
+    a background task for the agent turn, so by the time send() runs, the
+    inbound request's contextvar context may no longer be current. This is
+    the single most important correctness property this patch adds; see
+    line_multiplex's module docstring."""
+
+    def _make_adapter(self, monkeypatch):
+        monkeypatch.setenv("LINE_CHANNEL_ACCESS_TOKEN", "default-token")
+        monkeypatch.setenv("LINE_CHANNEL_SECRET", "default-secret")
+        from gateway.config import PlatformConfig
+        adapter = LineAdapter(
+            PlatformConfig(
+                enabled=True,
+                extra={
+                    "channels": [
+                        {
+                            "profile": "coder",
+                            "channel_secret": "coder-secret",
+                            "channel_access_token": "coder-token",
+                        }
+                    ]
+                },
+            )
+        )
+        adapter._channels.default().client = AsyncMock()
+        adapter._channels.by_profile("coder").client = AsyncMock()
+        return adapter
+
+    def test_send_with_no_context_and_unknown_chat_fails_cleanly(self, monkeypatch):
+        # Outside any request context (exactly like a background task) and
+        # to a chat_id this process has never seen inbound — the documented
+        # v1 limitation, not a crash.
+        adapter = self._make_adapter(monkeypatch)
+        result = asyncio.run(adapter.send("Uneverseen", "hello"))
+        assert result.success is False
+
+    def test_send_uses_the_remembered_channel_outside_any_context(self, monkeypatch):
+        # Simulates the real race this patch exists to close: the channel
+        # is remembered during inbound dispatch, then send() runs later
+        # with NO current() context at all (line_multiplex.current() is
+        # never set in this test) — exactly what a handle_message()
+        # background task looks like.
+        adapter = self._make_adapter(monkeypatch)
+        coder = adapter._channels.by_profile("coder")
+        adapter._channels.remember_chat("Ucandidate", coder)
+        assert line_multiplex.current() is None  # sanity: no context leaked in
+
+        asyncio.run(adapter.send("Ucandidate", "hello"))
+
+        coder.client.push.assert_awaited_once()
+        adapter._channels.default().client.push.assert_not_awaited()
+
+    def test_send_does_not_use_a_stale_contextvar_from_an_unrelated_channel(self, monkeypatch):
+        # If send() used self._client (the request-scoped property) instead
+        # of chat_id-based resolution, this would send coder's reply
+        # through whatever channel happened to be ambiently "current" —
+        # exactly the cross-channel bug this design prevents.
+        adapter = self._make_adapter(monkeypatch)
+        default = adapter._channels.default()
+        coder = adapter._channels.by_profile("coder")
+        adapter._channels.remember_chat("Ucandidate", coder)
+
+        token = line_multiplex.set_current(default)
+        try:
+            asyncio.run(adapter.send("Ucandidate", "hello"))
+        finally:
+            line_multiplex.reset_current(token)
+
+        coder.client.push.assert_awaited_once()
+        default.client.push.assert_not_awaited()
