+# ---------------------------------------------------------------------------
+# One-off join invites (Phase 6c: manager-initiated QR invite)
+# ---------------------------------------------------------------------------
+
+class LineInviteStore:
+    """One-off, single-use LINE join invites.
+
+    Deliberately separate from ``gateway.pairing.PairingStore``: a pairing
+    code binds to the identity it was generated *for* (see
+    ``PairingStore.approve_code``), but an invite is minted before the
+    candidate's real LINE user ID exists — there's nothing to bind to yet.
+    This store instead binds on *redemption*: whoever presents a live,
+    unexpired, unredeemed token first is the one who gets approved.
+
+    Mirrors ``PairingStore``'s hash-and-salt-at-rest, atomic-write
+    (temp file + rename, chmod 0600), and lockout-after-repeated-failures
+    patterns, since a matched token here grants access immediately with
+    no approval step — it needs the same guessing protection pairing
+    codes get, not less.
+
+    Imported directly by the ``line-invite`` skill's generation script
+    (``skills/line-invite/scripts/generate_invite.py`` in the
+    hermes-render repo, not this one) to keep the token format and
+    on-disk schema in one place rather than duplicated across the two
+    call sites.
+    """
+
+    def __init__(self) -> None:
+        from hermes_constants import get_hermes_dir
+        self._dir = get_hermes_dir("platforms/line-invites", "line-invites")
+        self._dir.mkdir(parents=True, exist_ok=True)
+        self._lock = threading.RLock()
+
+    def _invites_path(self) -> Path:
+        return self._dir / "invites.json"
+
+    def _state_path(self) -> Path:
+        return self._dir / "_redeem_state.json"
+
+    @staticmethod
+    def _load_json(path: Path) -> Dict[str, Any]:
+        if path.exists():
+            try:
+                data = json.loads(path.read_text(encoding="utf-8"))
+                return data if isinstance(data, dict) else {}
+            except (json.JSONDecodeError, OSError):
+                return {}
+        return {}
+
+    @staticmethod
+    def _save_json(path: Path, data: Dict[str, Any]) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        fd, tmp_path = tempfile.mkstemp(dir=str(path.parent), suffix=".tmp")
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(json.dumps(data, indent=2, ensure_ascii=False))
+                f.flush()
+                os.fsync(f.fileno())
+            os.replace(tmp_path, path)
+            try:
+                os.chmod(path, 0o600)
+            except OSError:
+                pass
+        except BaseException:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+            raise
+
+    @staticmethod
+    def _hash_token(token: str, salt: bytes) -> str:
+        return hashlib.sha256(salt + token.encode("utf-8")).hexdigest()
+
+    def mint(
+        self,
+        label: str,
+        created_by: str,
+        ttl_hours: float = LINE_INVITE_TTL_HOURS_DEFAULT,
+    ) -> str:
+        """Create a new one-off invite. Returns the plaintext token (shown once — only the salted hash is persisted)."""
+        with self._lock:
+            invites = self._load_json(self._invites_path())
+            token = "".join(
+                secrets.choice(LINE_INVITE_ALPHABET) for _ in range(LINE_INVITE_TOKEN_LENGTH)
+            )
+            salt = os.urandom(16)
+            entry_id = secrets.token_hex(8)
+            now = time.time()
+            invites[entry_id] = {
+                "hash": self._hash_token(token, salt),
+                "salt": salt.hex(),
+                "label": label,
+                "created_by": created_by,
+                "created_at": now,
+                "expires_at": now + max(0.0, ttl_hours) * 3600,
+                "redeemed": False,
+                "redeemed_by": None,
+                "redeemed_at": None,
+            }
+            self._save_json(self._invites_path(), invites)
+            return token
+
+    def _is_locked_out(self, uid: str) -> bool:
+        state = self._load_json(self._state_path())
+        return time.time() < state.get(f"lockout:{uid}", 0)
+
+    def _record_failed_attempt(self, uid: str) -> None:
+        state = self._load_json(self._state_path())
+        fail_key = f"failures:{uid}"
+        fails = state.get(fail_key, 0) + 1
+        state[fail_key] = fails
+        if fails >= LINE_INVITE_MAX_FAILED_ATTEMPTS:
+            state[f"lockout:{uid}"] = time.time() + LINE_INVITE_LOCKOUT_SECONDS
+            state[fail_key] = 0
+            logger.warning(
+                "LINE: invite redemption locked out for %s for %ss after %d failed attempts",
+                uid, LINE_INVITE_LOCKOUT_SECONDS, LINE_INVITE_MAX_FAILED_ATTEMPTS,
+            )
+        self._save_json(self._state_path(), state)
+
+    def try_redeem(self, uid: str, candidate_text: str) -> Optional[Dict[str, Any]]:
+        """Redeem ``candidate_text`` as an invite token if it's live and unused.
+
+        Fails safe: any non-match (typo/expired/redeemed/ordinary chat text
+        that isn't a token attempt at all) returns ``None`` without raising,
+        so callers can fall through to existing behavior unchanged. Guessing
+        protection is scoped per-``uid`` (not global) so one prankster can't
+        lock legitimate candidates out of redeeming a live invite.
+
+        Only text shaped like a real token attempt (right length, right
+        alphabet) counts against the per-uid failure counter — this keeps
+        ordinary DM chatter from strangers (Phase 1/6's manual-onboarding
+        path) from tripping the lockout.
+        """
+        candidate = (candidate_text or "").strip().upper()
+        if len(candidate) != LINE_INVITE_TOKEN_LENGTH or not set(candidate) <= set(LINE_INVITE_ALPHABET):
+            return None
+        with self._lock:
+            if self._is_locked_out(uid):
+                return None
+            invites = self._load_json(self._invites_path())
+            now = time.time()
+            matched_id = None
+            matched_entry = None
+            for entry_id, entry in invites.items():
+                if not isinstance(entry, dict) or entry.get("redeemed"):
+                    continue
+                if now >= entry.get("expires_at", 0):
+                    continue
+                try:
+                    salt = bytes.fromhex(entry["salt"])
+                except (ValueError, KeyError, TypeError):
+                    continue
+                if secrets.compare_digest(self._hash_token(candidate, salt), entry.get("hash", "")):
+                    matched_id = entry_id
+                    matched_entry = entry
+                    break
+
+            if matched_id is None:
+                self._record_failed_attempt(uid)
+                return None
+
+            invites[matched_id]["redeemed"] = True
+            invites[matched_id]["redeemed_by"] = uid
+            invites[matched_id]["redeemed_at"] = now
+            self._save_json(self._invites_path(), invites)
+            return dict(matched_entry)
+
+
