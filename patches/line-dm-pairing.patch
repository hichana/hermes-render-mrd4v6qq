+    async def _try_handle_invite_redemption(self, event: Dict[str, Any], uid: str) -> bool:
+        """Check an unrecognized DM's text against the invite store.
+
+        On a match: grant access immediately (``PairingStore._approve_user``,
+        under its lock, same as ``approve_code`` does internally — this is
+        deliberately *not* ``PairingStore.generate_code``/``approve_code``,
+        since those bind to an identity known at code-generation time, which
+        doesn't exist yet for an unmet candidate), mark the invite redeemed,
+        send a welcome reply, and best-effort notify whoever created the
+        invite. Returns ``True`` if the event was fully handled — the caller
+        must not fall through to the generic pairing-code reply in that case.
+
+        Fails safe: any non-match returns ``False`` immediately with no side
+        effects beyond the invite store's own per-uid guessing counter, so
+        today's dm_policy behavior is unchanged for anyone not presenting a
+        real invite token.
+        """
+        if event.get("type") != "message":
+            return False
+        msg = event.get("message") or {}
+        if msg.get("type") != "text":
+            return False
+
+        entry = self._invites.try_redeem(uid, msg.get("text", "") or "")
+        if entry is None:
+            return False
+
+        source = event.get("source") or {}
+        chat_id, _ = _resolve_chat(source)
+        reply_token = event.get("replyToken", "")
+        if chat_id and reply_token:
+            self._reply_tokens[chat_id] = (
+                reply_token,
+                time.time() + LINE_REPLY_TOKEN_TTL_SECONDS,
+            )
+
+        # Prefer LINE's own live profile (most authoritative, most current),
+        # then the name the manager supplied when minting the invite
+        # (skills/line-invite requires this — see its SKILL.md), and only
+        # fall back to the raw user ID if both are unavailable. Falling
+        # back straight to `uid` here was the original bug: it silently
+        # produced "Approved users" entries where the name column just
+        # repeated the ID, with no indication a real name was ever known.
+        display_name = entry.get("label") or uid
+        if self._client:
+            profile = await self._client.get_profile(uid)
+            if profile and profile.get("displayName"):
+                display_name = profile["displayName"]
+
+        from gateway.pairing import PairingStore
+        store = PairingStore()
+        with store._lock:
+            store._approve_user("line", uid, display_name)
+
+        if chat_id:
+            await self.send(chat_id, self.invite_welcome_text)
+
+        label = entry.get("label", "") or display_name
+        created_by = entry.get("created_by", "")
+        if created_by:
+            try:
+                await self.send(created_by, f"✅ {label} just joined via your invite!")
+            except Exception as exc:
+                logger.debug("LINE: invite-redeemed notify to %s failed: %s", created_by, exc)
+
+        logger.info("LINE: invite redeemed by %s (label=%r)", uid, entry.get("label", ""))
+        return True
