# Copy to clients/<slug>.env (gitignored) and fill in real values for that
# client. This file is the source of truth going forward -- edit it, then
# run `hermes-env-sync push <slug>`. Any key you leave out of this file is
# left completely untouched on the remote instance (e.g. anything set by
# hand through Hermes' own dashboard).
#
# IMPORTANT: just deleting a "KEY=value" line from this file does NOT
# remove that key remotely -- it's ambiguous with "I never had an opinion
# on this key" (e.g. a dashboard-managed value), so it's left alone on
# purpose. To actually remove a key from the remote instance, write a bang
# marker instead of deleting the line, e.g.:
#   !SOME_KEY_YOU_WANT_GONE
# (no "=", just "!" followed by the exact key name)

# --- LLM provider ---
# OPENROUTER_API_KEY=

# --- LINE ---
# LINE_BASIC_ID=@xxxxxxx
# LINE_PUBLIC_URL=https://<service>.onrender.com
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_ALLOWED_USERS=
# LINE_HOME_CHANNEL=
# LINE_SLOW_RESPONSE_THRESHOLD=0

# --- Telegram ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=
